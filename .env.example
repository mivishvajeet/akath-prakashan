# GEMINI_API_KEY: Required for Gemini AI API calls if used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The canonical URL where this platform is hosted.
APP_URL="https://akathpublication.arthsankalp.com"

# PORT: Express + Vite server port (must be 3000 in preview/container).
PORT="3000"

# PUBLISHER OPERATIONAL CONTACTS (Verified from existing Nanded site)
PUBLISHER_WHATSAPP_NUMBER="919270282932"
PUBLISHER_LOCATION="नांदेड, महाराष्ट्र (Nanded, Maharashtra)"

# PAYMENT PROVIDER CONFIGURATION (Razorpay / UPI Standard Webhook Verification)
# Leave blank in staging to use the built-in Verified Sandbox Payment Flow.
PAYMENT_PROVIDER_MODE="verified_sandbox"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# EDITORIAL & ORDER ADMIN ACCESS
# Server-side bootstrap token for provisioning initial administrator accounts
ADMIN_BOOTSTRAP_TOKEN="replace-with-strong-server-bootstrap-token"

# AUTHENTICATION & SESSION SECURITY CONFIGURATION
SESSION_COOKIE_NAME="akath_sid"
SESSION_TTL_HOURS="24"
AUTH_RATE_LIMIT_WINDOW_MS="900000"
AUTH_RATE_LIMIT_MAX_ATTEMPTS="5"
ORDER_LOOKUP_RATE_LIMIT_MAX="15"

# DATABASE & MIGRATION CONFIGURATION
DB_STORAGE_PATH="./.aistudio/akath-db.json"

