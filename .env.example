# Akath Prakashan — Environment Configuration Example
# Copy this file to .env for local development. Never commit real secrets.

# Server & Session Configuration
PORT=3000
NODE_ENV=development
SESSION_COOKIE_NAME=akath_sid
SESSION_TTL_HOURS=24

# Server-Controlled Administrator Bootstrap Token
# If omitted in development, a cryptographic token is auto-generated in .aistudio/server-bootstrap-token.txt
ADMIN_BOOTSTRAP_TOKEN=replace-with-strong-server-bootstrap-token

# Payment Gateway Webhook HMAC Secret (Used by /api/webhooks/payment)
PAYMENT_WEBHOOK_SECRET=whsec_akath_dev_hmac_secret_2026

# Persistent CMS Snapshot Storage Path (Optional override; defaults to .aistudio/cms-state.json)
CMS_STORAGE_FILE=.aistudio/cms-state.json

# Optional Server-Side Gemini API Key for AI-Assisted Draft Descriptions & SEO Metadata
# Managed automatically by AI Studio in Settings > Secrets
GEMINI_API_KEY=
